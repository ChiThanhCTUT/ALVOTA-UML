<UserControl x:Class="Library.Desktop.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Search Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="📚 Quản lý danh mục sách" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,24,0"/>

                <!-- Search Box -->
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Width="300" Height="38"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Button Content="Tìm kiếm" Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="38" Padding="14,0" Margin="0,0,10,0"/>

                <Button Content="➕ Thêm đầu sách mới"
                        Command="{Binding ToggleAddBookCommand}"
                        Style="{StaticResource SuccessButton}"
                        HorizontalAlignment="Right"
                        Height="38" Padding="16,0"/>
            </DockPanel>
        </Border>

        <!-- New Book Form (Collapsible) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                Visibility="{Binding IsAddingBook, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Nhập thông tin đầu sách mới (CAT-01, CAT-03)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Tiêu đề sách (*)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36"/>

                        <TextBlock Text="Mã chuẩn ISBN" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding NewIsbn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="Thể loại (*)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding NewSelectedCategory}"
                                  DisplayMemberPath="Name" Height="36" Padding="8,4"/>

                        <TextBlock Text="Nhà xuất bản (*)" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <ComboBox ItemsSource="{Binding Publishers}"
                                  SelectedItem="{Binding NewSelectedPublisher}"
                                  DisplayMemberPath="Name" Height="36" Padding="8,4"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Số lượng bản sao ban đầu (*)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewInitialCopies, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36"/>

                        <TextBlock Text="Vị trí kệ ban đầu" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding NewShelf, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ" Command="{Binding ToggleAddBookCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,10,0" Padding="16,6"/>
                    <Button Content="Lưu đầu sách" Command="{Binding SaveNewBookCommand}" Style="{StaticResource PrimaryButton}" Padding="20,6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Books DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding Books}" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tiêu đề sách" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="150"/>
                    <DataGridTextColumn Header="Thể loại" Binding="{Binding CategoryName}" Width="140"/>
                    <DataGridTextColumn Header="Nhà xuất bản" Binding="{Binding PublisherName}" Width="150"/>
                    <DataGridTextColumn Header="Giá bìa" Binding="{Binding Price, StringFormat='{}{0:N0} đ'}" Width="100"/>
                    <DataGridTextColumn Header="Sẵn sàng" Binding="{Binding AvailableCopies}" Width="80"/>
                    <DataGridTextColumn Header="Tổng bản" Binding="{Binding TotalCopies}" Width="80"/>
                    <DataGridTemplateColumn Header="Thao tác" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+ Thêm bản"
                                        Command="{Binding DataContext.AddCopiesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource OutlinedButton}"
                                        Padding="8,2" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding TotalCount, StringFormat='{}Tổng số: {0} đầu sách'}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="◀ Trang trước" Command="{Binding PreviousPageCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0" Padding="12,4"/>
                <TextBlock Text="{Binding PageIndex, StringFormat='{}Trang {0}'}" VerticalAlignment="Center" FontWeight="Bold" Margin="4,0,4,0"/>
                <TextBlock Text="{Binding TotalPages, StringFormat='{}/ {0}'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Trang sau ▶" Command="{Binding NextPageCommand}" Style="{StaticResource OutlinedButton}" Padding="12,4"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
