<UserControl x:Class="Library.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <!-- Background Decorative Elements -->
        <Border Width="460" Height="520"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="36">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#94A3B8" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <!-- Logo & Title -->
                <TextBlock Text="📖 THƯ VIỆN TRƯỜNG HỌC"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Hệ thống quản lý thư viện Desktop .NET 8"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Username -->
                <TextBlock Text="Tên đăng nhập"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Height="42"
                         Margin="0,0,0,16"/>

                <!-- Password -->
                <TextBlock Text="Mật khẩu"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Height="42"
                         Margin="0,0,0,20"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Login Button -->
                <Button Content="ĐĂNG NHẬP"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="44"
                        FontSize="15"
                        FontWeight="Bold"
                        Margin="0,0,0,16"/>

                <TextBlock Text="Mặc định: admin / Admin@123 hoặc librarian / Librarian@123"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
