<Window x:Class="Library.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Library.Desktop.ViewModels"
        xmlns:views="clr-namespace:Library.Desktop.Views"
        mc:Ignorable="d"
        Title="Hệ Thống Quản Lý Thư Viện Trường Học (Desktop .NET 8)"
        Height="800" Width="1280"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CirculationViewModel}">
            <views:CirculationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogViewModel}">
            <views:CatalogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemberViewModel}">
            <views:MemberView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FineViewModel}">
            <views:FineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <views:SystemView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="8,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- KeyBindings for shortcuts (F2, F3, Ctrl+F) -->
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NavigateCommand}" CommandParameter="Circulation"/>
        <KeyBinding Key="F3" Command="{Binding NavigateCommand}" CommandParameter="Circulation"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="Catalog"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel>
                <!-- App Logo & Brand -->
                <Border DockPanel.Dock="Top" Padding="20,24" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="📖 THƯ VIỆN" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Quản lý thư viện trường học" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Current User Card -->
                <Border DockPanel.Dock="Bottom" Padding="16" Background="#1E293B">
                    <DockPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock Text="{Binding CurrentUserRole, StringFormat='Vai trò: {0}'}" FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="Đăng xuất" Command="{Binding LogoutCommand}"
                                Style="{StaticResource OutlinedButton}"
                                HorizontalAlignment="Right" Padding="8,4" FontSize="11" Foreground="#F87171" BorderBrush="#EF4444"/>
                    </DockPanel>
                </Border>

                <!-- Navigation Menu Items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <Button Content="📊  Tổng quan" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource SidebarButton}"/>
                        <Button Content="🔄  Mượn / Trả sách" Command="{Binding NavigateCommand}" CommandParameter="Circulation" Style="{StaticResource SidebarButton}"/>
                        <Button Content="📚  Quản lý sách" Command="{Binding NavigateCommand}" CommandParameter="Catalog" Style="{StaticResource SidebarButton}"
                                IsEnabled="{Binding CanAccessCatalogAndFines}"/>
                        <Button Content="👤  Quản lý bạn đọc" Command="{Binding NavigateCommand}" CommandParameter="Members" Style="{StaticResource SidebarButton}"/>
                        <Button Content="💰  Quản lý phạt" Command="{Binding NavigateCommand}" CommandParameter="Fines" Style="{StaticResource SidebarButton}"
                                IsEnabled="{Binding CanAccessCatalogAndFines}"/>
                        <Button Content="📦  Kiểm kê kho" Command="{Binding NavigateCommand}" CommandParameter="Inventory" Style="{StaticResource SidebarButton}"/>
                        <Button Content="📈  Báo cáo thống kê" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource SidebarButton}"/>
                        <Button Content="⚙️  Hệ thống &amp; Cấu hình" Command="{Binding NavigateCommand}" CommandParameter="System" Style="{StaticResource SidebarButton}"
                                IsEnabled="{Binding CanAccessSystem}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SchoolName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Phím tắt: F2 (Mượn) | F3 (Trả) | Ctrl+F (Tìm sách)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Active View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
